# QR 코드에 들어갈 PC 주소 (폰이 접속할 LAN IP). 비우면 브라우저 Host 헤더를 사용.
PUBLIC_HOST=192.168.0.10

# 호스트에 노출할 포트 (443/80 이 이미 사용 중이면 변경, 예: 8443/8080)
HTTPS_PORT=443
HTTP_PORT=80

SESSION_TTL=3600
# 함께 그리기: 그림판·폰이 모두 끊긴 플레이어 자리(색·QR)를 유지하는 시간(초). 새로고침해도 같은 자리로 돌아옴
PLAYER_IDLE_SEC=300

# Cloudflare Tunnel 고정 주소용 토큰 (--profile tunnel 일 때만 필요, 임시 주소는 불필요)
# Zero Trust 대시보드 > Networks > Tunnels 에서 발급, Public Hostname 은 http://edge:8081 로 지정
TUNNEL_TOKEN=

# 제스처 튜닝
STABLE_FRAMES=3
SAVE_FRAMES=15
CLEAR_FRAMES=30
# 색상 창: 검지·중지를 붙이고(TOGETHER_RATIO) 좌우로 SHAKE_AMP 이상 SHAKE_WINDOW_MS 안에 SHAKE_TURNS 번 흔들기
# 붙여도 인식이 안 되면 TOGETHER_RATIO 를 키우고, ✌ 에서도 열리면 줄임
TOGETHER_RATIO=1.2
SHAKE_AMP=0.02
SHAKE_TURNS=3
SHAKE_WINDOW_MS=1000
# 색상 창에서 한 칸 넘기는 좌우 이동량(그림판 폭 비율). 너무 잘 넘어가면 키우고, 잘 안 넘어가면 줄임
SWIPE_DIST=0.09
DRAW_RELEASE_FRAMES=6
LOST_GRACE_MS=300
THUMB_MARGIN=0.2
# 핀치(지우개) 인정 거리(손 크기 비율). 잘 안 잡히면 PINCH_RATIO 를 키우고, 그리다가 지워지면 줄임
PINCH_RATIO=0.3
PINCH_RELEASE_RATIO=0.45
# 카메라 여백(좌우 / 위 / 아래). 그림판 하단이 안 닿으면 ACTIVE_BOTTOM 을 키우고, 너무 빨리 닿으면 줄임
ACTIVE_MARGIN=0.1
ACTIVE_TOP=0.05
ACTIVE_BOTTOM=0.4
FILTER_MIN_CUTOFF=1.5
FILTER_BETA=5.0
