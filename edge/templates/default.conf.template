# nginx 공식 이미지가 시작 시 envsubst 로 ${HTTPS_PORT} 를 치환해 conf.d/default.conf 생성
# 폰 브라우저는 HTTPS 에서만 카메라(getUserMedia)를 허용하므로 edge 에서 TLS 종료.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream gateway {
    server c1_gateway:8000;
}

server {
    listen 80;
    server_name _;
    return 301 https://$host:${HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    set $via_tunnel "";
    include /etc/nginx/snippets/airsketch-locations.conf;
}

# Cloudflare Tunnel 전용 (호스트에 노출하지 않음, cloudflared 컨테이너만 접근).
# TLS 는 Cloudflare 가 종료하므로 여기선 평문 HTTP.
server {
    listen 8081;
    server_name _;

    set $via_tunnel 1;
    include /etc/nginx/snippets/airsketch-locations.conf;
}
